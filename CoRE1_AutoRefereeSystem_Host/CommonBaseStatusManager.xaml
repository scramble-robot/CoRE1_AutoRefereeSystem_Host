<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CoRE1_AutoRefereeSystem_Host"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             x:Class="CoRE1_AutoRefereeSystem_Host.CommonBaseStatusManager"
             mc:Ignorable="d"
             d:DesignHeight="460"
             d:Background="White"
             Loaded="UserControl_Loaded"
             IsEnabledChanged="UserControl_IsEnabledChanged">
    <Grid Background="{Binding CommonBaseColor, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
        <StackPanel Orientation="Horizontal">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label Content="{Binding CommonBaseLabel, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                           d:Content="Base-C"
                           Margin="10,10,5,10"
                           FontSize="24"
                           FontWeight="Bold" />
                    <ProgressBar x:Name="OccupationLevelBar"
                                 Height="20"
                                 Width="200"
                                 Margin="20,10,5,10"
                                 Background="#FF0015E6"
                                 Foreground="#FFE61500"
                                 BorderBrush="#FF0B1508"
                                 Maximum="10"
                                 Value="5" />
                    <TextBox x:Name="PointTextBox"
                             TextWrapping="Wrap"
                             Text="N/A"
                             Margin="10,10,5,10"
                             Width="70"
                             FontSize="18"
                             TextAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,5,0,10"
                            HorizontalAlignment="Center">
                    <Label Content="Time Until Neutral Point ..."
                           FontSize="16"
                           Margin="28,0,5,5" />
                    <TextBox x:Name="ResetTimeTextBox"
                             IsEnabled="False"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             d:Text="30 sec.."
                             FontSize="16"
                             Margin="5,0,10,5"
                             Width="70"
                             TextAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,10">
                    <Button x:Name="RedLevelButton"
                            Content="RED"
                            Click="RedLevelButton_Click"
                            Margin="5,5,5,5"
                            Width="100"
                            BorderBrush="#FFB7403A"
                            Background="#FFB7403A" />
                    <Button x:Name="NeurtralButton"
                            Content="NEUTRAL"
                            Margin="10,5,5,5"
                            Width="100"
                            Background="White"
                            Foreground="Black"
                            BorderBrush="White"
                            Click="NeurtralButton_Click"
                            VerticalAlignment="Bottom" />
                    <Button x:Name="BlueLevelButton"
                            Content="BLUE"
                            Click="BlueLevelButton_Click"
                            Margin="10,5,5,5"
                            Width="100"
                            Background="#FF3A6FB7"
                            BorderBrush="#FF3A6FB7" />
                </StackPanel>

                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel x:Name="RedBaseDPPanel"
                                Grid.Column="0"
                                Orientation="Horizontal"
                                Background="#10FF0000">
                        <StackPanel>
                            <Label Content="Left RDP"
                                   HorizontalAlignment="Center"
                                   FontSize="14" />
                            <Image x:Name="DamagePanelRL"
                                   Source="Images/damagePanel.png"
                                   Width="70"
                                   Height="70"
                                   Stretch="Uniform" />
                            <TextBox x:Name="InvincibleTimeTextBoxRL"
                                     Text="1s"
                                     Width="60"
                                     FontSize="14"
                                     IsReadOnly="True"
                                     Background="#67FFFFFF"
                                     Margin="0,5,0,5" />
                        </StackPanel>
                        <StackPanel>
                            <Label Content="Center RDP"
                                   HorizontalAlignment="Center"
                                   FontSize="14" />
                            <Image x:Name="DamagePanelRC"
                                   Source="Images/damagePanel.png"
                                   Width="70"
                                   Height="70"
                                   Stretch="Uniform" />
                            <TextBox x:Name="InvincibleTimeTextBoxRC"
                                     Text="1s"
                                     Width="60"
                                     FontSize="14"
                                     IsReadOnly="True"
                                     Background="#67FFFFFF"
                                     HorizontalAlignment="Center"
                                     Margin="0,5,0,5" />
                        </StackPanel>
                        <StackPanel>
                            <Label Content="Right RDP"
                                   HorizontalAlignment="Center"
                                   FontSize="14" />
                            <Image x:Name="DamagePanelRR"
                                   Source="Images/damagePanel.png"
                                   Width="70"
                                   Height="70"
                                   Stretch="Uniform" />
                            <TextBox x:Name="InvincibleTimeTextBoxRR"
                                     Text="1s"
                                     Width="60"
                                     FontSize="14"
                                     IsReadOnly="True"
                                     Background="#67FFFFFF"
                                     HorizontalAlignment="Center"
                                     Margin="0,5,0,5" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel x:Name="BlueBaseDPPanel"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Background="#100000FF">
                        <StackPanel>
                            <Label Content="Left BDP"
                                   HorizontalAlignment="Center"
                                   FontSize="14" />
                            <Image x:Name="DamagePanelBL"
                                   Source="Images/damagePanel.png"
                                   Width="70"
                                   Height="70"
                                   Stretch="Uniform" />
                            <TextBox x:Name="InvincibleTimeTextBoxBL"
                                     Text="1s"
                                     Width="60"
                                     FontSize="14"
                                     IsReadOnly="True"
                                     Background="#67FFFFFF"
                                     HorizontalAlignment="Center"
                                     Margin="0,5,0,5" />
                        </StackPanel>
                        <StackPanel>
                            <Label Content="Center BDP"
                                   HorizontalAlignment="Center"
                                   FontSize="14" />
                            <Image x:Name="DamagePanelBC"
                                   Source="Images/damagePanel.png"
                                   Width="70"
                                   Height="70"
                                   Stretch="Uniform" />
                            <TextBox x:Name="InvincibleTimeTextBoxBC"
                                     Text="1s"
                                     Width="60"
                                     FontSize="14"
                                     IsReadOnly="True"
                                     Background="#67FFFFFF"
                                     HorizontalAlignment="Center"
                                     Margin="0,5,0,5" />
                        </StackPanel>
                        <StackPanel>
                            <Label Content="Right BDP"
                                   HorizontalAlignment="Center"
                                   FontSize="14" />
                            <Image x:Name="DamagePanelBR"
                                   Source="Images/damagePanel.png"
                                   Width="70"
                                   Height="70"
                                   Stretch="Uniform" />
                            <TextBox x:Name="InvincibleTimeTextBoxBR"
                                     Text="1s"
                                     Width="60"
                                     FontSize="14"
                                     IsReadOnly="True"
                                     Background="#67FFFFFF"
                                     HorizontalAlignment="Center"
                                     Margin="0,5,0,5" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <Label Content="Robot Log"
                       Margin="10,0,10,0"
                       FontSize="16"
                       FontWeight="Bold" />

                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="RobotLogTextBox"
                             TextWrapping="Wrap"
                             d:Text="[0:10:2] Hit"
                             Margin="15,0,15,10"
                             FontSize="12"
                             Height="125"
                             Width="310"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             Background="#66FFFFFF" />
                    <Button x:Name="PingButton1"
                            Content="Ping"
                            Margin="5,0,10,10"
                            Click="PingButton_Click"
                            VerticalAlignment="Bottom" />
                </StackPanel>

            </StackPanel>
            <StackPanel>
                <Label Content="Received Data from Base"
                       Margin="10,0,10,0"
                       FontSize="14" />
                <TextBox x:Name="ReceivedDataTextBox1"
                         TextWrapping="Wrap"
                         d:Text="*** autoRef HOST *** P3.02h&#xA;ID:0107542 GroupeID:0107592&#xA;CH:15 nodeNo[0503]&#xA;&gt;"
                         Margin="15,0,15,10"
                         FontSize="12"
                         Height="100"
                         Width="270"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         Background="#67FFFFFF" />
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="HostStatusTextBox"
                             Text="Not Connected"
                             IsEnabled="False"
                             FontSize="13"
                             Margin="10,10,5,10"
                             FontWeight="Bold"
                             IsReadOnly="True"
                             VerticalAlignment="Center"
                             Width="275" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="EndPointTextBox"
                             materialDesign:HintAssist.Hint="Endpoint {IP}:{PORT}"
                             TextWrapping="Wrap"
                             FontSize="14"
                             Style="{DynamicResource MaterialDesignTextBox}"
                             Margin="10,5,0,5"
                             Width="130"
                             TextChanged="EndPointTextBox_TextChanged"
                             KeyDown="EndPointTextBox_KeyDown" />
                    <Button x:Name="OpenButton"
                            Content="Open"
                            Margin="10,5,0,5"
                            Click="OpenButton_Click"
                            HorizontalAlignment="Left"
                            Width="70" />
                    <Button x:Name="BootButton"
                            Content="Boot"
                            Margin="5,5,5,5"
                            Background="#FF44B73A"
                            BorderBrush="#FF44B73A"
                            Click="BootButton_Click" />
                </StackPanel>
                <Label Content="HostPCB Link Log"
                       Margin="10,5,10,0"
                       FontSize="16" />
                <TextBox x:Name="LinkTextBox"
                         TextWrapping="Wrap"
                         d:Text="*** autoRef HOST *** P3.02h&#xA;ID:0107542 GroupeID:0107592&#xA;CH:15 nodeNo[0503]&#xA;&gt;"
                         Margin="15,0,15,10"
                         FontSize="12"
                         Height="150"
                         Width="270"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         Background="#67FFFFFF" />
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="SendDataTextBox"
                             materialDesign:HintAssist.Hint="Command"
                             TextWrapping="Wrap"
                             FontSize="12"
                             Style="{DynamicResource MaterialDesignTextBox}"
                             Margin="10,0,5,10"
                             Width="200"
                             KeyDown="SendDataTextBox_KeyDown" />
                    <Button x:Name="SendButton"
                            Content="Send"
                            Margin="10,0,10,10"
                            FontSize="14"
                            Click="SendButton_Click" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
                      